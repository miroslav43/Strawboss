# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of the Nest API (origin only, no trailing slash).
# Production build: baked into the Next.js client bundle — must be the URL browsers use.
NEXT_PUBLIC_API_URL=https://your-domain.com
# Optional: absolute URLs for Open Graph / metadata (admin-web)
# NEXT_PUBLIC_SITE_URL=https://nortiauno.com

# Local Android APK: ./strawboss.sh mobile-build-local (optional if SDK is not under ~/Android/Sdk)
# ANDROID_HOME=/root/Android/Sdk

# Dev-only: URL the Next.js dev server proxies /api/v1/* to (avoids CORS).
# Defaults to http://localhost:3001 so undeployed endpoints (e.g. new routes) work locally.
# Override only if you want to test against a remote backend during development.
# NEXT_DEV_API_PROXY_URL=http://localhost:3001

# Email for Let's Encrypt certificate notifications (used by ssl:init).
CERTBOT_EMAIL=your-email@example.com

# Outbound email via Resend (transport-confirmation emails to driver + requester).
# Get a key at resend.com; RESEND_FROM must be on a domain you verified there
# (SPF/DKIM). Without both, emails are written `failed` in the /messages monitor.
# Must also be listed in docker-stack.yml's strawboss-backend environment block.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=StrawBoss <no-reply@nortiauno.com>
# Optional: absolute URL to a small raster (PNG/JPG) logo shown in the confirmation
# email header. Use a raster export, not the brand SVG — some mail clients (older
# Outlook) don't render SVG <img>. Unset → the header falls back to text only.
# Must also be listed in docker-stack.yml's strawboss-backend environment block.
# EMAIL_LOGO_URL=https://nortiauno.com/brand/strawboss-logo.png

# FCM sender credential — enables OTA-acceleration + the presence dead-man wake
# (FCM high-priority pushes wake a device-owner phone that has gone silent in deep
# Doze, which the Doze-throttled on-device alarms can't beat). Path to the Firebase
# service-account JSON (download from Firebase console → Project settings → Service
# accounts). Keep the file gitignored — it is a private key. Prod (Swarm) bind-mounts
# it read-only to /app/firebase-sa.json (see docker-stack.yml); this path is for a
# local backend. Unset → FCM disabled (devices fall back to the ~poll cadence).
# FIREBASE_SERVICE_ACCOUNT_FILE=/srv/apps/Strawboss/firebase-service-account.json
# (Alternatively FIREBASE_SERVICE_ACCOUNT=<inline minified JSON>.)

# Redis password for Docker Compose redis service.
REDIS_PASSWORD=changeme

# Optional: directory for rotated JSON logs (web/ and mobile/ subtrees). Docker sets /app/logs.
# LOG_ROOT=/srv/apps/Strawboss/logs

# Optional: directory for user-generated uploads (receipts + avatars). Docker sets
# /app/uploads and mounts ./uploads from the host. Local dev defaults to ./uploads
# at the monorepo root. Layout: <root>/receipts/ for mobile receipt photos,
# <root>/avatars/{userId}.webp for profile pictures.
# UPLOADS_ROOT=/srv/apps/Strawboss/uploads

# Master kill-switch for per-organization feature toggles (super-admin console →
# organization → Funcționalități). Default ON, following the repo's other
# switches (`!== 'false'`). Setting it to 'false' makes every organization
# resolve to zero disabled features — i.e. everything enabled, exactly the
# behaviour that existed before the feature shipped — with no rebuild. It never
# degrades the other way.
# Already listed in docker-stack.yml's strawboss-backend environment block, so a
# stack redeploy keeps whatever is set here. The backend logs the resolved value
# once at boot; grep logs/web/ for "feature flags".
# STRAWBOSS_ORG_FEATURE_FLAGS_ENABLED=true
