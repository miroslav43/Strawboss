FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/types/package.json packages/types/
COPY packages/validation/package.json packages/validation/
COPY packages/api/package.json packages/api/
COPY packages/ui-tokens/package.json packages/ui-tokens/
# admin-web imports composeAuxStage() from @strawboss/domain (the aux-stage
# ladder on the Curse page). Local `tsc` resolves it by walking up to the root
# node_modules whether or not it is declared — Docker installs only the declared
# graph, so omitting it here fails the build with "Module not found".
COPY packages/domain/package.json packages/domain/
COPY apps/admin-web/package.json apps/admin-web/
RUN --mount=type=cache,id=pnpm-admin,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/types/node_modules ./packages/types/node_modules
COPY --from=deps /app/packages/validation/node_modules ./packages/validation/node_modules
COPY --from=deps /app/packages/api/node_modules ./packages/api/node_modules
COPY --from=deps /app/packages/ui-tokens/node_modules ./packages/ui-tokens/node_modules
COPY --from=deps /app/packages/domain/node_modules ./packages/domain/node_modules
COPY --from=deps /app/apps/admin-web/node_modules ./apps/admin-web/node_modules
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY packages/types/ packages/types/
COPY packages/validation/ packages/validation/
COPY packages/api/ packages/api/
COPY packages/ui-tokens/ packages/ui-tokens/
COPY packages/domain/ packages/domain/
COPY apps/admin-web/ apps/admin-web/
# Build dependencies first, in dependency order:
#   types -> validation -> ui-tokens -> domain -> api
RUN pnpm --filter @strawboss/types build
RUN pnpm --filter @strawboss/validation build
RUN pnpm --filter @strawboss/ui-tokens build
RUN pnpm --filter @strawboss/domain build
RUN pnpm --filter @strawboss/api build
# Build Next.js — NEXT_PUBLIC_* vars must be present at build time
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm --filter @strawboss/admin-web build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# Next.js standalone mode copies what's needed
COPY --from=builder /app/apps/admin-web/.next/standalone ./
COPY --from=builder /app/apps/admin-web/.next/static ./apps/admin-web/.next/static
COPY --from=builder /app/apps/admin-web/public ./apps/admin-web/public

EXPOSE 3000
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
RUN mkdir -p /app/logs && chown -R appuser:appgroup /app/logs
USER appuser
CMD ["node", "apps/admin-web/server.js"]
