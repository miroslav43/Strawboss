<!DOCTYPE html>
<html lang="{{lang}}">
<head>
  <meta charset="UTF-8" />
  <title>CMR — {{tripNumber}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Arial, sans-serif; font-size: 11px; color: #1a1a1a; padding: 20mm 15mm; }
    h1 { font-size: 18px; text-align: center; color: #0A5C36; margin-bottom: 2px; }
    .subtitle { text-align: center; font-size: 10px; color: #666; margin-bottom: 16px; }
    .logo-row { text-align: center; margin-bottom: 8px; font-size: 14px; font-weight: bold; color: #0A5C36; letter-spacing: 2px; }

    table { width: 100%; border-collapse: collapse; margin-bottom: 12px; }
    td, th { border: 1px solid #999; padding: 5px 8px; vertical-align: top; }
    th { background: #f5f0ed; text-align: left; width: 35%; font-weight: 600; color: #333; }
    .section-header { background: #0A5C36; color: white; font-weight: 700; text-align: center; font-size: 11px; padding: 4px; }
    .section-header td { border-color: #0A5C36; }

    .two-col { display: flex; gap: 12px; margin-bottom: 12px; }
    .two-col > div { flex: 1; }

    .signatures { margin-top: 24px; page-break-inside: avoid; }
    .sig-grid { display: flex; justify-content: space-between; gap: 16px; margin-top: 8px; }
    .sig-box { flex: 1; border: 1px solid #ccc; border-radius: 4px; padding: 8px; min-height: 100px; text-align: center; }
    .sig-box .label { font-weight: 600; font-size: 10px; color: #666; margin-bottom: 4px; }
    .sig-box .name { font-weight: 700; font-size: 12px; margin-bottom: 8px; }
    .sig-box img { max-width: 180px; max-height: 70px; }
    .sig-empty { height: 60px; border: 1px dashed #ccc; border-radius: 4px; margin-top: 4px; }

    .footer { margin-top: 20px; text-align: center; font-size: 9px; color: #999; border-top: 1px solid #ddd; padding-top: 8px; }
    .highlight { color: #0A5C36; font-weight: 600; }
  </style>
</head>
<body>
  <div class="logo-row">STRAWBOSS</div>
  <h1>{{labels.title}}</h1>
  <p class="subtitle">{{labels.tripNoLabel}} <strong>{{tripNumber}}</strong> &mdash; {{date}}</p>

  <!-- 1. Expeditor -->
  <table>
    <tr class="section-header"><td colspan="2">{{labels.sectionSender}}</td></tr>
    <tr><th>{{labels.parcel}}</th><td class="highlight">{{parcelName}}</td></tr>
    <tr><th>{{labels.address}}</th><td>{{senderAddress}}{{#if senderMunicipality}}, {{senderMunicipality}}{{/if}}</td></tr>
  </table>

  <!-- 2. Destinatar -->
  <table>
    <tr class="section-header"><td colspan="2">{{labels.sectionRecipient}}</td></tr>
    <tr><th>{{labels.depotName}}</th><td class="highlight">{{destinationName}}</td></tr>
    <tr><th>{{labels.address}}</th><td>{{destinationAddress}}</td></tr>
  </table>

  <!-- 3. Transportator -->
  <table>
    <tr class="section-header"><td colspan="2">{{labels.sectionCarrier}}</td></tr>
    <tr><th>{{labels.truck}}</th><td>{{truckName}} &mdash; <strong>{{truckPlate}}</strong></td></tr>
    <tr><th>{{labels.driver}}</th><td class="highlight">{{driverName}}</td></tr>
  </table>

  <!-- 4. Marfa -->
  <table>
    <tr class="section-header"><td colspan="2">{{labels.sectionGoods}}</td></tr>
    <tr><th>{{labels.baleCount}}</th><td class="highlight">{{baleCount}}</td></tr>
    <tr><th>{{labels.loadCount}}</th><td>{{baleLoadCount}}</td></tr>
    <tr><th>{{labels.grossWeight}}</th><td>{{grossWeightKg}}</td></tr>
    <tr><th>{{labels.tareWeight}}</th><td>{{tareWeightKg}}</td></tr>
    <tr><th>{{labels.netWeight}}</th><td class="highlight">{{netWeightKg}}</td></tr>
    <tr><th>{{labels.weightTicket}}</th><td>{{weightTicketNumber}}</td></tr>
  </table>

  <!-- 5. Detalii cursă -->
  <table>
    <tr class="section-header"><td colspan="2">{{labels.sectionTripDetails}}</td></tr>
    <tr><th>{{labels.departure}}</th><td>{{departureAt}}</td></tr>
    <tr><th>{{labels.arrival}}</th><td>{{arrivalAt}}</td></tr>
    <tr><th>{{labels.deliveryConfirmed}}</th><td>{{deliveredAt}}</td></tr>
    <tr><th>{{labels.distance}}</th><td class="highlight">{{gpsDistanceKm}}</td></tr>
  </table>

  {{#if deliveryNotes}}
  <table>
    <tr class="section-header"><td colspan="2">{{labels.sectionObservations}}</td></tr>
    <tr><td colspan="2">{{deliveryNotes}}</td></tr>
  </table>
  {{/if}}

  <!-- Semnături -->
  <div class="signatures">
    <table>
      <tr class="section-header"><td colspan="2">{{#if deliveryNotes}}7{{else}}6{{/if}}. {{labels.sectionSignatures}}</td></tr>
    </table>
    <div class="sig-grid">
      <div class="sig-box">
        <div class="label">{{labels.senderOperatorSignature}}</div>
        <div class="name">{{#if loaderName}}{{loaderName}}{{else}}&nbsp;{{/if}}</div>
        {{#if loaderSignatureUrl}}
        <img src="{{loaderSignatureUrl}}" alt="{{labels.operatorSignatureAlt}}" />
        {{else}}
        <div class="sig-empty"></div>
        {{/if}}
      </div>
      <div class="sig-box">
        <div class="label">{{labels.driverCarrierSignature}}</div>
        <div class="name">{{driverName}}</div>
        {{#if driverSignatureUrl}}
        <img src="{{driverSignatureUrl}}" alt="{{labels.driverSignatureAlt}}" />
        {{else}}
        <div class="sig-empty"></div>
        {{/if}}
      </div>
      <div class="sig-box">
        <div class="label">{{labels.receiver}}</div>
        <div class="name">{{#if receiverName}}{{receiverName}}{{else}}&nbsp;{{/if}}</div>
        {{#if receiverSignatureUrl}}
        <img src="{{receiverSignatureUrl}}" alt="{{labels.receiverSignatureAlt}}" />
        {{else}}
        <div class="sig-empty"></div>
        {{/if}}
      </div>
    </div>
  </div>

  <div class="footer">
    {{labels.footerGenerated}} StrawBoss &mdash; {{date}} &mdash; {{labels.footerTrip}} {{tripNumber}}
  </div>
</body>
</html>
